<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToHeight="true" fitToWidth="true" maxHeight="Infinity" maxWidth="Infinity"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.CustomTargetController">

    <VBox spacing="20.0">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- Disabled warning label (shown if data source is not ready) -->
        <Label fx:id="dataSourceWarningLabel"
               text="⚠ Data source needs to be initialized first"
               disable="true"
               style="-fx-text-fill: red; -fx-font-size: 18px; -fx-font-weight: bold; -fx-alignment: center;"
               visible="false"
               maxWidth="Infinity" />

        <!-- Tracking label -->
        <Label fx:id="trackingDataLabel" text="Tracking Data: [ 0.0 ; 0.0 ; 0.0 ]" />

        <!-- Main controls area -->
        <HBox spacing="25.0">

            <HBox spacing="20.0">
                <VBox spacing="8.0">
                    <Label text="Select Target" style="-fx-font-weight: bold;" />
                    <ListView fx:id="targetsListView" prefHeight="400.0" prefWidth="250.0" />
                    <Button text="Select Target" onAction="#onSelectTargetClicked" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="8.0">
                    <Label text="Select Tool" style="-fx-font-weight: bold;" />
                    <ListView fx:id="toolsListView" prefHeight="400.0" prefWidth="250.0" />
                    <Button text="Select Tool" onAction="#onSelectToolClicked" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <!-- Right control column -->
            <VBox spacing="10.0">
                <Button fx:id="startToolAugmentationButton" text="Start Tool Augmentation" />
                <Label fx:id="augmentationLabel"
                       text="X: ...&#10;Y: ...&#10;Z: ...."
                       style="-fx-font-family: monospace; -fx-padding: 5; -fx-border-color: lightgray; -fx-background-color: #f8f8f8;"
                       wrapText="true"
                       prefWidth="500.0"
                       minWidth="500.0"
                       maxWidth="500.0" />

            </VBox>

        </HBox>

    </VBox>
</ScrollPane>
