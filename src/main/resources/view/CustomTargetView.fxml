<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<ScrollPane fitToHeight="true" fitToWidth="true" maxHeight="Infinity" maxWidth="Infinity"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.CustomTargetController">

    <VBox spacing="20.0">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- Disabled warning label (shown if data source is not ready) -->
        <Label fx:id="dataSourceWarningLabel"
               text="⚠ Data source needs to be initialized first"
               disable="true"
               style="-fx-text-fill: red; -fx-font-size: 18px; -fx-font-weight: bold; -fx-alignment: center;"
               visible="false"
               maxWidth="Infinity" />

        <!-- Tracking label -->
        <Label fx:id="trackingDataLabel" text="Tracking Data: [ 0.0 ; 0.0 ; 0.0 ]" />

        <!-- Main controls area -->
        <HBox spacing="25.0">

            <HBox spacing="20.0">
                <VBox spacing="8.0">
                    <Label text="Select Target" style="-fx-font-weight: bold;" />
                    <ListView fx:id="targetsListView" prefHeight="400.0" prefWidth="250.0" />
                    <Button text="Select Target" onAction="#onSelectTargetClicked" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="8.0">
                    <Label text="Select Tool" style="-fx-font-weight: bold;" />
                    <ListView fx:id="toolsListView" prefHeight="400.0" prefWidth="250.0" />
                    <Button text="Select Tool" onAction="#onSelectToolClicked" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <!-- Right control column -->
            <VBox spacing="10.0">
                <Button fx:id="startToolAugmentationButton" text="Start Tool Augmentation" />
                <Label fx:id="augmentationLabel"
                       text="X: ...&#10;Y: ...&#10;Z: ...."
                       style="-fx-font-family: monospace; -fx-padding: 5; -fx-border-color: lightgray; -fx-background-color: #f8f8f8;"
                       wrapText="true"
                       prefWidth="500.0"
                       minWidth="500.0"
                       maxWidth="500.0" />

            </VBox>
        </HBox>
        <AnchorPane fx:id="distanceVisualizer" prefHeight="100.0" prefWidth="300.0"
                    style="-fx-border-color: #ccc; -fx-background-color: #fafafa;"
                    VBox.vgrow="NEVER">
            <!-- X axis -->
            <HBox layoutY="10" spacing="5" alignment="CENTER_LEFT">
                <Label text="X:" style="-fx-font-weight: bold;"/>
                <StackPane prefWidth="200" prefHeight="8" style="-fx-background-color: #ddd;">
                    <Circle fx:id="xCircle" radius="6" fill="#ff6666"/>
                </StackPane>
            </HBox>

            <!-- Y axis -->
            <HBox layoutY="40" spacing="5" alignment="CENTER_LEFT">
                <Label text="Y:" style="-fx-font-weight: bold;"/>
                <StackPane prefWidth="200" prefHeight="8" style="-fx-background-color: #ddd;">
                    <Circle fx:id="yCircle" radius="6" fill="#66b3ff"/>
                </StackPane>
            </HBox>

            <!-- Z axis -->
            <HBox layoutY="70" spacing="5" alignment="CENTER_LEFT">
                <Label text="Z:" style="-fx-font-weight: bold;"/>
                <StackPane prefWidth="200" prefHeight="8" style="-fx-background-color: #ddd;">
                    <Circle fx:id="zCircle" radius="6" fill="#66ff66"/>
                </StackPane>
            </HBox>
        </AnchorPane>
    </VBox>
</ScrollPane>
